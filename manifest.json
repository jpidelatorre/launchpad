{
  "manifest_version": 3,
  "name": "Launchpad — Bookmark New Tab",
  "version": "1.0.0",
  "description": "A fast, keyboard-friendly New Tab launchpad displaying bookmarks from a user-defined bookmark folder.",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Launchpad",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
